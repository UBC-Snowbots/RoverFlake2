        <mesh filename="package://rover_description/meshes/chassis/rocker_left.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="RockerL_joint" type="revolute">
    <origin xyz="-0.25 0.2319125 0.103175" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="RockerL_Link" />
    <axis xyz="0 1 0" />
    <limit lower="-0.35" upper="0.35" effort="0" velocity="0" />
  </joint>
  <link name="WFL_Link">
