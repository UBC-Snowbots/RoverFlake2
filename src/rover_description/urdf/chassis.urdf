<?xml version="1.0" encoding="utf-8"?>
<!-- Big rover (Chassis.SLDASM). Hand-built from SolidWorks exports, same structure as mini_rover.urdf.
     Frame + 2 rockers + 2 bogies + 6 wheels; rockers coupled through the differential bar via <mimic>.
     See rover_description/CLAUDE.md ("Big rover") for where every number came from and what is a placeholder. -->
<robot name="Chassis">
  <link name="base_link">
    <inertial>
      <origin xyz="-0.323229813769833 0.000141183589907848 0.120313130621598" rpy="0 0 0" />
