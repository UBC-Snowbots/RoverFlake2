# mapviz_offline.mvc — template config: offline tile source + GPS path
# + waypoint markers. The launch files render this into config/<site>.mvc
# (substituting site/base_url/fix topic) and symlink ~/.mapviz_config at it.
#
# NOTE: mapviz .mvc schemas drift between releases. If mapviz doesn't pick
# up a display from this file, configure it once through the GUI
# (tile_map -> Source -> "Custom WMTS Source...", Base URL below; add the
# navsat + marker displays), then File -> Save Config over config/<site>.mvc
# and copy the fixed sections back into this template. Commit the result.
capture_directory: "~"
fixed_frame: map
target_frame: <none>
fix_orientation: false
rotate_90: false
enable_antialiasing: true
show_displays: true
show_status_bar: true
show_capture_tools: true
window_width: 1600
window_height: 900
view_scale: 0.3
offset_x: 0
offset_y: 0
use_latest_transforms: true
background: "#a0a0a4"
image_transport: raw
displays:
  - type: mapviz_plugins/tile_map
    name: Offline Imagery
    config:
      visible: true
      collapsed: true
      custom_sources:
        - base_url: http://localhost:8000/competition_site/tiles/{level}/{x}/{y}.png
          max_zoom: 20
          name: offline_competition_site
          type: wmts
      bing_api_key: ""
      source: offline_competition_site
  - type: mapviz_plugins/navsat
    name: GPS Path
    config:
      visible: true
      collapsed: true
      topic: /gnss_fix
      color: "#00ccff"
      draw_style: lines
      position_tolerance: 0.5
      buffer_size: 0
  - type: mapviz_plugins/marker
    name: Waypoints
    config:
      visible: true
      collapsed: true
      topic: /waypoints
